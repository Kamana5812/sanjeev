# Local testing: no email is sent. Preview is disabled in production.
MAIL_MODE=preview

# For real enquiries use MAIL_MODE=smtp and your own server credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COMPANY_EMAIL=

# Blank means same-origin only. Optional extra origins, separated by commas:
# ALLOWED_ORIGINS=https://your-frontend.example
ALLOWED_ORIGINS=